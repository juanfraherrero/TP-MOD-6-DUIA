DATABASE_URL=postgres://test:test@localhost:5432/test

# LLM provider (groq | gemini | ollama | openai). Default: gemini.
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com → Get API key)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI (https://platform.openai.com/api-keys)
# Modelos recomendados: gpt-4o-mini (barato, tool calling sólido) | gpt-4o (más caro y mejor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:14b

# Búsqueda web (https://tavily.com — free tier 1000 req/mes)
TAVILY_API_KEY=

AUTH_SECRET=
LOG_LEVEL=debug

# # # # Groq (https://console.groq.com)
# # # GROQ_API_KEY=
# # # GROQ_MODEL=llama-3.3-70b-versatile
