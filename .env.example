# Postgres con pgvector. En Supabase: Settings → Database → Connection string
# (modo "Transaction pooler", URI). Termina en ...pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# LLM provider (gemini | groq | openai | ollama). Default: gemini.
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com → Get API key) — también se usa para embeddings.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Modelo de embeddings de Gemini. `gemini-embedding-001` con
# outputDimensionality=768 (hardcoded en el código) devuelve vectores de 768
# dims compatibles con la migration vector(768).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (https://platform.openai.com/api-keys) — opcional, solo si LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (https://console.groq.com) — opcional, solo si LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — solo para desarrollo local con LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:14b

# Búsqueda web (https://tavily.com — free tier 1000 req/mes)
TAVILY_API_KEY=

AUTH_SECRET=
LOG_LEVEL=info
