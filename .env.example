DATABASE_URL=postgres://test:test@localhost:5432/test

# # # # LLM provider 
LLM_PROVIDER=ollama

# # # # Gemini (https://aistudio.google.com → Get API key)
# # # GOOGLE_API_KEY=
# # # GEMINI_MODEL=gemini-2.0-flash

# # # # Groq (https://console.groq.com)
# # # GROQ_API_KEY=
# # # GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — LLM local o remoto.
#
# Local (CPU, máquinas sin GPU):
#   1. `curl -fsSL https://ollama.com/install.sh | sh`
#   2. `ollama pull qwen2.5-coder:7b`  (~4.7GB, ~8GB RAM; tool calling aceptable)
#   3. Setear OLLAMA_MODEL=qwen2.5-coder:7b y LLM_PROVIDER=ollama.
#
# Remoto (recomendado para 14B+ con GPU NVIDIA):
#   Ver docs/OLLAMA_REMOTE_SETUP.md — setup de servidor Proxmox + CUDA.
#   Ejemplo: OLLAMA_BASE_URL=http://192.168.1.100:11434
#
# Con docker-compose y --profile ollama, la URL dentro de la red del compose
# es http://ollama:11434.
#
# Ver docs/OLLAMA_MODELS.md para la tabla comparativa de modelos.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:14b

# Búsqueda web (https://tavily.com — free tier 1000 req/mes)
TAVILY_API_KEY=

AUTH_SECRET=
LOG_LEVEL=debug
